{
  "rules": {
    ".read": false,
    ".write": false,

    "allowlist": {
      "$uuid": {
        ".read": "auth != null",
        ".write": false
      }
    },

    "users": {
      "$uuid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('allowlist').child($uuid).child('status').val() === 'active' && newData.child('uid').val() === auth.uid && (!data.exists() || (newData.child('publicKey').val() === data.child('publicKey').val() && (!data.child('uid').exists() || data.child('uid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['publicKey','uid','updated']) && newData.child('publicKey').isString() && newData.child('publicKey').val().length <= 64 && newData.child('uid').isString()"
      }
    },

    "conversations": {
      "$cid": {
        ".read": "auth != null",
        "messages": {
          "$mid": {
            ".write": "auth != null && !data.exists() && root.child('allowlist').child(newData.child('from').val()).child('status').val() === 'active' && root.child('users').child(newData.child('from').val()).child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['from','to','ts','n','c']) && newData.child('n').isString() && newData.child('c').isString() && newData.child('c').val().length <= 400000"
          }
        },
        "typing": {
          "$uuid": {
            ".write": "auth != null && root.child('allowlist').child($uuid).child('status').val() === 'active' && root.child('users').child($uuid).child('uid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          }
        },
        "read": {
          "$uuid": {
            ".write": "auth != null && root.child('allowlist').child($uuid).child('status').val() === 'active' && root.child('users').child($uuid).child('uid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          }
        },
        "reactions": {
          "$mid": {
            "$uuid": {
              ".write": "auth != null && root.child('allowlist').child($uuid).child('status').val() === 'active' && root.child('users').child($uuid).child('uid').val() === auth.uid",
              ".validate": "newData.hasChildren(['n','c']) && newData.child('n').isString() && newData.child('c').isString() && newData.child('c').val().length <= 2000"
            }
          }
        }
      }
    }
  }
}
